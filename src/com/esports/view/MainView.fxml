<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esports.controller.MainController"
            prefWidth="1000" prefHeight="700">
    
    <!-- Top title bar (顶部标题栏) -->
    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #2c3e50;">
            <Label text="⚡ Esports Player Management System (电竞选手管理系统)" textFill="white">
                <font>
                    <Font name="System Bold" size="24" />
                </font>
            </Label>
            <Label text="Professional Esports Player Management System" textFill="#ecf0f1">
                <font>
                    <Font name="System" size="12" />
                </font>
            </Label>
        </VBox>
    </top>
    
    <!-- Left navigation bar (左侧导航栏) -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #34495e; -fx-padding: 20;">
            <Button text="🏠 Player Management (选手管理)" fx:id="btnPlayers" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#showPlayerManagement" />
            
            <Button text="📝 Contract Management (合同管理)" fx:id="btnContracts" 
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#showContractManagement" />
            
            <Button text="🏆 Tournament Records (比赛记录)" fx:id="btnTournaments" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#showTournamentManagement" />
            
            <Button text="📊 Data Statistics (数据统计)" fx:id="btnStatistics" 
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#showStatistics" />
            
            <Separator style="-fx-background-color: #7f8c8d;" />
            
            <Button text="❓ About (关于)" fx:id="btnAbout" 
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#showAbout" />
            
            <Button text="🚪 Exit (退出)" fx:id="btnExit" 
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
                    onAction="#exitApplication" />
            <!-- Ensure tournament record button calls correct method (确保比赛记录按钮调用正确的方法) -->
            <Button text="🏆 Tournament Records (比赛记录)" fx:id="btnTournaments" 
        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-width: 150;"
        onAction="#showTournamentManagement" />    
           
        </VBox>
    </left>
    
    <!-- Center content area (中心内容区域) -->
    <center>
        <StackPane fx:id="contentPane">
            <!-- Initially display welcome message (初始显示欢迎信息) -->
            <VBox alignment="CENTER" spacing="20">
                <Label text="Welcome to Esports Player Management System (欢迎使用电竞选手管理系统)" style="-fx-font-size: 28; -fx-text-fill: #2c3e50;">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>
                <Label text="Please select function module from left to start operation (请从左侧选择功能模块开始操作)" style="-fx-font-size: 16; -fx-text-fill: #7f8c8d;" />
                <!-- Remove ImageView part as there is no image file (删除ImageView部分，因为没有图片文件) -->
                <Label text="🎮 🎯 🏆" style="-fx-font-size: 48;" />
            </VBox>
        </StackPane>
    </center>
    
    <!-- Bottom status bar (底部状态栏) -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10;" alignment="CENTER_LEFT">
            <Label fx:id="lblStatus" text="Ready (就绪)" style="-fx-text-fill: #2c3e50;" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label text="Total Players (选手总数): 10 | Total Contracts (合同总数): 4 | Tournament Records (比赛记录): 5" style="-fx-text-fill: #7f8c8d;" />
        </HBox>
    </bottom>
    
    <padding>
        <Insets top="0" right="0" bottom="0" left="0" />
    </padding>
</BorderPane>